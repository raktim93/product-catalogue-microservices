{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":          { "type": "long" },
      "name":        { "type": "text", "fields": { "sort": { "type": "keyword", "normalizer": "lowercase" } } },
      "description": { "type": "text" },
      "category":    { "type": "keyword" },
      "price":       { "type": "scaled_float", "scaling_factor": 100 },
      "version":     { "type": "long" },
      "deleted":     { "type": "boolean" }
    }
  }
}